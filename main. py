import os
import threading
from http.server import BaseHTTPRequestHandler, HTTPServer

from telegram import Update
from telegram.ext import (
    Application,
    CommandHandler,
    ContextTypes,
)


# =========================
# HEALTH CHECK UNTUK RENDER
# =========================

class HealthHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/plain")
        self.end_headers()
        self.wfile.write(b"Danier-FX Bot is running!")

    def log_message(self, format, *args):
        return


def start_web_server():
    port = int(os.environ.get("PORT", 10000))
    server = HTTPServer(("0.0.0.0", port), HealthHandler)
    print(f"Health server running on port {port}")
    server.serve_forever()


# =========================
# TELEGRAM BOT
# =========================

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "🔥 Danier-FX aktif!\n\n"
        "Selamat datang, Bot berhasil terhubung. 🚀\n\n"
        "Ketik /help untuk bantuan."
    )


async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "📚 Bantuan Danier-FX\n\n"
        "/start - Mulai bot\n"
        "/help - Bantuan"
    )


# =========================
# MAIN
# =========================

def main():

    token = os.environ.get("BOT_TOKEN")

    if not token:
        raise RuntimeError(
            "BOT_TOKEN belum diatur di Environment Variables."
        )

    # Jalankan server HTTP untuk Render
    web_thread = threading.Thread(
        target=start_web_server,
        daemon=True
    )
    web_thread.start()

    # Buat Telegram application
    app = Application.builder().token(token).build()

    # Command Telegram
    app.add_handler(
        CommandHandler("start", start)
    )

    app.add_handler(
        CommandHandler("help", help_command)
    )

    print("Danier-FX Telegram Bot starting...")

    # Jalankan bot
    app.run_polling()


if name == "main":
    main()
